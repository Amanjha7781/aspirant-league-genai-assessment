# Optional OpenAI-compatible chat-completions endpoint. Leave unset to fail closed.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# RAG embedding model downloads once on first use; CPU execution is supported.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional local paths for persisted indexes/documents (defaults are under each app).
RAG_DATA_DIR=rag_app/data
EXTRACTION_MAX_UPLOAD_BYTES=5242880

